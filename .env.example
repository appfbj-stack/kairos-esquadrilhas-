# ===== Aplicacao =====
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="Kairos Esquadrilhas 3D"

# ===== Auth (NextAuth v5) =====
# Em producao, gere um valor seguro: openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-em-producao-use-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Quando true, habilita o botao "Entrar como demo" na tela de login.
# Use true em homologacao/dev. Em producao real, mantenha false.
ENABLE_DEMO_MODE=true

# ===== Banco de dados (Postgres) =====
# Em Docker local, use o host "postgres" (nome do servico).
# Em Dokploy, sera o endereco do servico postgres da stack.
DATABASE_URL=postgresql://kairos:kairos@postgres:5432/kairos_esquadrias

# ===== Storage (S3 / MinIO / Local) =====
# Fase 1: arquivos locais em /app/uploads (montado via volume no Dokploy).
# Fase 2: trocar por S3/MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_PUBLIC_URL=http://localhost:3000/api/files

# ===== IA (camada abstrata) =====
# Provedor padrao para o Assistente Kairos. Fase 8 do roadmap.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-3.5-sonnet

# ===== Uploads =====
MAX_UPLOAD_MB=10
